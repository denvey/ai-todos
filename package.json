{
  "name": "ai-todos",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "Standalone local Codex productivity plugin",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "start": "node src/server.ts",
    "open": "node scripts/open.ts",
    "stop": "node scripts/stop.ts",
    "mcp": "node src/mcp.ts",
    "check": "node --test test/*.test.js",
    "package:plugin": "node scripts/package-plugin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-select": "2.3.3",
    "i18next": "26.4.3",
    "lucide-react": "0.525.0",
    "react": "19.1.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.1.1",
    "react-i18next": "17.0.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
